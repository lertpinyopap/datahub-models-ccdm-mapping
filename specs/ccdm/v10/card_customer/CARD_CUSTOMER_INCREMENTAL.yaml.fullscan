id: card_customer_historical_incremental
extends: card_customer_historical_initial_load
description: >
  Incremental CARD_CUSTOMER SCD2 load that retains every distinct
  effective-dated source state, including multiple changes for the same
  customer in one source delivery.
source:
  format: table
  query: |
    with ambs_acct as (
        select
            AMBS_CUST_NBR,
            min(AMBS_DATE_OPENED) as AMBS_DATE_OPENED
        from DATAOPS_HUB_SHARE_VISION{{ var("DATAOPS_ENV_SUFFIX", "_NONPROD") }}.RAW.ACCOUNT_BASE_SEGMENT
        group by AMBS_CUST_NBR
    ),
    current_card_customer as (
        select
            CUSTOMER_ID,
            CREATED_DATETIME
        from {{ var("database") }}.CORE.{{ var("card_customer_table", "CARD_CUSTOMER") }}
        where IS_CURRENT_FLAG = 'Y'
          and coalesce(IS_DELETED_FLAG, 'N') <> 'Y'
        qualify row_number() over (
            partition by CUSTOMER_ID
            order by VALID_FROM_DATETIME desc, AUDIT_LAST_CHANGED_DATETIME desc
        ) = 1
    )
    select distinct
        C.AMNA_ADD_STATUS,
        C.AMNA_STATUS,
        case
            when C.AMNA_ADD_STATUS = 99
             and C.AMNA_STATUS = 0 then 'Y'
            else 'N'
        end as IS_ACTIVE_IN_SOURCE_FLAG,
        C.AMNA_ACCT as CUSTOMER_ID,
        C.AMNA_TITLE_01 as TITLE,
        C.AMNA_FIRST_NAME_01 as FIRST_NAME,
        C.AMNA_MIDDLE_NAME_01 as MIDDLE_NAME,
        C.AMNA_LAST_NAME_01 as SURNAME,
        C.AMNA_DOB_01 as DATE_OF_BIRTH,
        C.AMNA_DATE_LAST_MAINT as UPDATED_DATETIME,
        coalesce(current_card_customer.CREATED_DATETIME, A.AMBS_DATE_OPENED)
            as CREATED_DATETIME,
        case
            when C.AMNA_DATE_LAST_MAINT is null
              or C.AMNA_DATE_LAST_MAINT
                    < coalesce(current_card_customer.CREATED_DATETIME, A.AMBS_DATE_OPENED)
                then coalesce(current_card_customer.CREATED_DATETIME, A.AMBS_DATE_OPENED)
            else C.AMNA_DATE_LAST_MAINT
        end as SOURCE_EFFECTIVE_FROM_DATETIME
    from DATAOPS_HUB_SHARE_VISION{{ var("DATAOPS_ENV_SUFFIX", "_NONPROD") }}.RAW.CUSTOMER as C
    inner join ambs_acct as A
        on C.AMNA_ACCT = A.AMBS_CUST_NBR
    left join current_card_customer
        on C.AMNA_ACCT = current_card_customer.CUSTOMER_ID
    where C.AMNA_EMAIL_01 not like '%TEST%' 
    and C.AIRFLOW_DAG_TIME = (
      select max(AIRFLOW_DAG_TIME)
          from DATAOPS_HUB_SHARE_VISION{{ var("DATAOPS_ENV_SUFFIX", "_NONPROD") }}.RAW.CUSTOMER
          where AMNA_EMAIL_01 not like '%TEST%'
        )
      
